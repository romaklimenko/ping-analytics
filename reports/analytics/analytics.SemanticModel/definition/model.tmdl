model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: da-DK
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

annotation PBI_QueryOrder = ["dim_geo","dim_page","fact_events","fact_sessions"]

ref table dim_geo
ref table dim_page
ref table fact_events
ref table fact_sessions

ref cultureInfo en-US

